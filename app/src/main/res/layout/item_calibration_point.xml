<?xml version="1.0" encoding="utf-8"?>
<!--  item_calibration_point.xml - one row in the calibration points list -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_8"
    app:cardCornerRadius="@dimen/card_corner_radius_small"
    app:cardElevation="@dimen/card_elevation"
    app:cardBackgroundColor="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_12"
        android:gravity="center_vertical">

        <!-- Index badge -->
        <TextView
            android:id="@+id/tvPointIndex"
            android:layout_width="@dimen/spacing_32"
            android:layout_height="@dimen/spacing_32"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:background="@drawable/bg_circle_accent"
            android:layout_marginEnd="@dimen/spacing_12"
            tools:text="1" />

        <!-- Values -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_2">

                <TextView
                    android:id="@+id/tvPointDiff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="@dimen/text_body_small"
                    tools:text="Colour diff: 42.30" />

                <TextView
                    android:id="@+id/tvPointPpm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    tools:text="5.000 ppm.hr" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPointLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextHint"
                android:textSize="@dimen/text_caption"
                android:visibility="gone"
                tools:text="Lab test 25-Aug 14:00"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Delete button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeletePoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            android:text="✕"
            android:textColor="@color/colorStatusDanger"
            android:minWidth="0dp"
            android:paddingStart="@dimen/spacing_8"
            android:paddingEnd="@dimen/spacing_8"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
