<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- - Phase 2: Camera & storage permissions - -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Network access for backend communication -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- READ_EXTERNAL_STORAGE only needed below API 33 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Camera feature - not strictly required, but advertises the requirement -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.H2SDosimeter">

        <!-- - Phase 1 activities - -->

        <!-- Splash Screen - LAUNCHER activity -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.H2SDosimeter.Splash"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login -->
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.H2SDosimeter.Login"
            android:screenOrientation="portrait" />

        <!-- Worker Dashboard -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.H2SDosimeter.Dashboard"
            android:screenOrientation="portrait" />

        <!-- - Phase 2 scan flow activities - -->

        <!-- Scan entry - badge info + checklist -->
        <activity
            android:name=".ui.scan.ScanActivity"
            android:exported="false"
            android:theme="@style/Theme.H2SDosimeter"
            android:screenOrientation="portrait" />

        <!-- Camera capture screen -->
        <activity
            android:name=".ui.scan.CaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.H2SDosimeter"
            android:screenOrientation="portrait" />

        <!-- Colorimetric processing animation -->
        <activity
            android:name=".ui.scan.ProcessingActivity"
            android:exported="false"
            android:theme="@style/Theme.H2SDosimeter"
            android:screenOrientation="portrait" />

        <!-- Scan result summary -->
        <activity
            android:name=".ui.scan.ScanResultActivity"
            android:exported="false"
            android:theme="@style/Theme.H2SDosimeter"
            android:screenOrientation="portrait" />

        <!-- Full exposure record detail -->
        <activity
            android:name=".ui.scan.ExposureDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.H2SDosimeter"
            android:screenOrientation="portrait" />

        <!-- Calibration management screen -->
        <activity
            android:name=".calibration.CalibrationActivity"
            android:exported="false"
            android:theme="@style/Theme.H2SDosimeter"
            android:screenOrientation="portrait" />

        <!-- - FileProvider for camera image URI (Phase 2) - -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- - Placeholder declarations for future phases - -->
        <!--
        <activity android:name=".ui.history.ExposureHistoryActivity" android:exported="false" />
        <activity android:name=".ui.history.ShiftDetailsActivity" android:exported="false" />
        <activity android:name=".ui.history.BadgeDetailsActivity" android:exported="false" />
        <activity android:name=".ui.profile.ProfileActivity" android:exported="false" />
        <activity android:name=".ui.settings.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.settings.SafetyInfoActivity" android:exported="false" />
        <activity android:name=".ui.dashboard.SafetyOfficerDashboardActivity" android:exported="false" />
        <activity android:name=".ui.dashboard.ReportsActivity" android:exported="false" />
        -->

    </application>

</manifest>
