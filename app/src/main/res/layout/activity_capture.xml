<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_capture.xml - Camera capture screen.
    In the demo/frontend phase this shows a simulated viewfinder.
    Real camera integration requires CameraX and runtime permission.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ui.scan.CaptureActivity">

    <!-- CameraX PreviewView - live rear camera feed -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- Demo overlay - shown when no real camera is available -->
    <LinearLayout
        android:id="@+id/demoOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC0D2137"
        android:visibility="visible"
        tools:visibility="visible">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_sensor_strip"
            android:tint="@color/colorAccent"
            android:contentDescription="@string/cd_sensor_strip"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEMO MODE"
            android:textColor="@color/colorAccent"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Camera unavailable or permission denied.\nTap \'Use Demo Image\' to continue with mock analysis."
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:lineSpacingMultiplier="1.4" />
    </LinearLayout>

    <!-- Viewfinder guide overlay (shown during real camera use) -->
    <RelativeLayout
        android:id="@+id/viewfinderGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Corner guide frame (drawn in overlay) -->
        <View
            android:layout_width="260dp"
            android:layout_height="200dp"
            android:layout_centerInParent="true"
            android:background="@android:color/transparent"
            android:contentDescription="@null" />
    </RelativeLayout>

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#800D2137"
        android:layout_gravity="top">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_scan"
            android:tint="@color/white"
            android:contentDescription="@string/btn_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Capture Badge"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- DEMO label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_demo"
            style="@style/H2SDemoBadge"
            android:layout_marginEnd="8dp" />
    </LinearLayout>

    <!-- Bottom control bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:background="#CC0D2137"
        android:padding="20dp"
        android:gravity="center">

        <!-- Instructions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keep all 4 red corner marks and the colour card inside the frame. Avoid glare."
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Use demo image (always available) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUseDemoImage"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Use Demo Image"
                android:textAllCaps="false"
                android:textSize="14sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/colorAccent"
                android:textColor="@color/colorAccent" />

            <!-- Shutter button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCapture"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Capture"
                android:textAllCaps="false"
                android:textSize="14sp"
                style="@style/H2SButtonAccent"
                app:icon="@drawable/ic_scan"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Disclaimer note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/disclaimer_app"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3" />
    </LinearLayout>

</FrameLayout>
