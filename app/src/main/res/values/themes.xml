<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- =====================================================
         H2S DOSIMETER - BASE THEME
         Material3 + custom industrial safety palette
         ===================================================== -->
    <style name="Theme.H2SDosimeter" parent="Theme.MaterialComponents.Light.NoActionBar">

        <!-- Primary brand colour -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorTextOnPrimary</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccentDark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background / surface -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/colorPrimary</item>

        <!-- Default text appearance (using system sans-serif; swap for custom font if needed) -->
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <item name="android:fontFamily">sans-serif</item>

        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeSmall</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeMedium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeLarge</item>
    </style>

    <!-- Splash - full-screen immersive, no status bar -->
    <style name="Theme.H2SDosimeter.Splash" parent="Theme.H2SDosimeter">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/colorSplashStart</item>
    </style>

    <!-- Login - light status bar on dark primary bg -->
    <style name="Theme.H2SDosimeter.Login" parent="Theme.H2SDosimeter">
        <item name="android:statusBarColor">@color/colorPrimary</item>
    </style>

    <!-- Dashboard - standard -->
    <style name="Theme.H2SDosimeter.Dashboard" parent="Theme.H2SDosimeter">
        <item name="android:statusBarColor">@color/colorPrimary</item>
    </style>

    <!-- =====================================================
         SHAPE APPEARANCES
         ===================================================== -->
    <style name="ShapeSmall" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeMedium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeLarge" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- =====================================================
         WIDGET STYLES
         ===================================================== -->

    <!-- PRIMARY BUTTON -->
    <style name="H2SButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="android:textColor">@color/white</item>
        <item name="elevation">3dp</item>
    </style>

    <!-- ACCENT BUTTON -->
    <style name="H2SButtonAccent" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="android:textColor">@color/white</item>
        <item name="elevation">3dp</item>
    </style>

    <!-- OUTLINED BUTTON -->
    <style name="H2SButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textSize">@dimen/button_text_size</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>

    <!-- TEXT BUTTON (ghost) -->
    <style name="H2SButtonText" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorAccent</item>
    </style>

    <!-- CARD -->
    <style name="H2SCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/colorSurface</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- CARD raised -->
    <style name="H2SCardRaised" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">@dimen/card_elevation_raised</item>
    </style>

    <!-- STATUS CHIP - safe -->
    <style name="H2SChipSafe" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/colorStatusSafeBg</item>
        <item name="android:textColor">@color/colorStatusSafe</item>
        <item name="chipStrokeColor">@color/colorStatusSafeLight</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/chip_corner_radius</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- STATUS CHIP - warning -->
    <style name="H2SChipWarning" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/colorStatusWarningBg</item>
        <item name="android:textColor">@color/colorStatusWarning</item>
        <item name="chipStrokeColor">@color/colorStatusWarningLight</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/chip_corner_radius</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- STATUS CHIP - danger -->
    <style name="H2SChipDanger" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/colorStatusDangerBg</item>
        <item name="android:textColor">@color/colorStatusDanger</item>
        <item name="chipStrokeColor">@color/colorStatusDangerLight</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/chip_corner_radius</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- TOOLBAR -->
    <style name="H2SToolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/colorPrimary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/colorAccent</item>
    </style>

    <!-- INPUT LAYOUT -->
    <style name="H2SInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner_radius</item>
        <item name="boxStrokeColor">@color/colorBorder</item>
        <item name="hintTextColor">@color/colorTextHint</item>
        <item name="android:textColorHint">@color/colorTextHint</item>
    </style>

    <!-- DEMO BADGE label style -->
    <style name="H2SDemoBadge">
        <item name="android:background">@drawable/bg_demo_badge</item>
        <item name="android:textColor">@color/colorDemoLabel</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:paddingStart">@dimen/spacing_6</item>
        <item name="android:paddingEnd">@dimen/spacing_6</item>
        <item name="android:paddingTop">@dimen/spacing_2</item>
        <item name="android:paddingBottom">@dimen/spacing_2</item>
    </style>

</resources>




