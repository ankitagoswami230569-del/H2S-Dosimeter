<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider paths for camera image capture.
    Used by CaptureActivity when taking photos with the system camera intent.
    Phase 2: camera URI sharing requires this configuration.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Internal app cache - preferred for temporary capture images -->
    <cache-path
        name="cached_images"
        path="images/" />
    <!-- External files dir (if needed for sharing) -->
    <external-files-path
        name="external_images"
        path="Pictures/" />
</paths>
