<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_splash"
    tools:context=".ui.splash.SplashActivity">

    <View
        android:id="@+id/decorRingTopLeft"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.07"
        android:background="@drawable/bg_circle_accent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:translationX="-60dp"
        android:translationY="-60dp" />

    <View
        android:id="@+id/decorRingBottomRight"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:alpha="0.05"
        android:background="@drawable/bg_circle_accent"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:translationX="80dp"
        android:translationY="80dp" />

    <LinearLayout
        android:id="@+id/splashBottomGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="56dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true">

        <ImageView
            android:id="@+id/splashSensorStrip"
            android:layout_width="180dp"
            android:layout_height="72dp"
            android:contentDescription="@string/cd_sensor_strip"
            android:src="@drawable/ic_sensor_strip"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/splashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textColor="#7A9BBF"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textAllCaps="true"
            android:gravity="center" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/splashProgress"
        style="@android:style/Widget.ProgressBar.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/splashBottomGroup"
        android:layout_marginBottom="24dp"
        android:indeterminateTint="@color/colorAccent" />

    <LinearLayout
        android:id="@+id/splashCenterGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:layout_marginBottom="80dp">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/cd_app_logo"
            android:src="@drawable/ic_logo"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:gravity="center" />

        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center"
            android:background="@color/colorAccent" />

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textColor="#B0C4D8"
            android:textSize="14sp"
            android:letterSpacing="0.04"
            android:gravity="center" />

    </LinearLayout>

</RelativeLayout>