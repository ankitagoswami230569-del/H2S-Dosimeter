<?xml version="1.0" encoding="utf-8"?>
<!--
    Login Screen - H2S Dosimeter
    Polished dark-header + light card layout.
    Includes: role selection chips, credentials fields,
              remember me, forgot password, demo login button.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".ui.login.LoginActivity">

    <!-- Dark navy header section -->
    <LinearLayout
        android:id="@+id/loginHeader"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_header_primary"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="@dimen/status_bar_padding"
        android:paddingBottom="@dimen/spacing_32">

        <!-- App Logo -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/cd_app_logo"
            android:src="@drawable/ic_logo"
            android:layout_marginBottom="@dimen/spacing_12" />

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.10" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/app_subtitle"
            android:textColor="#B0C4D8"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Scrollable content below header -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingTop="190dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_40">

            <!-- Login Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="@dimen/card_elevation_raised"
                app:cardBackgroundColor="@color/colorSurface"
                android:layout_marginTop="-50dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_24">

                    <!-- Sign In heading -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_title"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/spacing_4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_subtitle"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_body_small"
                        android:layout_marginBottom="@dimen/spacing_24" />

                    <!-- - Role Selection - -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_select_role"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="@dimen/text_caption"
                        android:letterSpacing="0.10"
                        android:textAllCaps="true"
                        android:layout_marginBottom="@dimen/spacing_8" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/roleChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        android:layout_marginBottom="@dimen/spacing_20">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipWorker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/role_worker"
                            android:checkable="true"
                            android:checked="true"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            app:chipBackgroundColor="@color/selector_chip_role" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSafetyOfficer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/role_safety_officer"
                            android:checkable="true"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            app:chipBackgroundColor="@color/selector_chip_role" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAdmin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/role_admin"
                            android:checkable="true"
                            style="@style/Widget.MaterialComponents.Chip.Filter"
                            app:chipBackgroundColor="@color/selector_chip_role" />

                    </com.google.android.material.chip.ChipGroup>

                    <!-- - Worker ID field - -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWorkerId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        android:hint="@string/hint_worker_id"
                        style="@style/H2SInputLayout"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/colorTextHint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWorkerId"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionNext"
                            android:textSize="@dimen/text_body" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- - Password field - -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_12"
                        android:hint="@string/hint_password"
                        style="@style/H2SInputLayout"
                        app:startIconDrawable="@drawable/ic_badge"
                        app:startIconTint="@color/colorTextHint"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/colorTextHint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:textSize="@dimen/text_body" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- - Remember me + Forgot password row - -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_24">

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/cbRememberMe"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/lbl_remember_me"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="@dimen/text_body_small"
                            app:buttonTint="@color/colorAccent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnForgotPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_forgot_password"
                            style="@style/H2SButtonText"
                            android:textSize="@dimen/text_body_small"
                            android:minHeight="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp" />

                    </LinearLayout>

                    <!-- - Login Button - -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:text="@string/btn_login"
                        style="@style/H2SButtonPrimary"
                        android:layout_marginBottom="@dimen/spacing_12" />

                    <!-- Divider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_12">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/colorDivider" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="or"
                            android:textColor="@color/colorTextHint"
                            android:textSize="@dimen/text_caption"
                            android:paddingStart="@dimen/spacing_12"
                            android:paddingEnd="@dimen/spacing_12" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/colorDivider" />

                    </LinearLayout>

                    <!-- Demo Login Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDemoLogin"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:text="@string/btn_demo_login"
                        style="@style/H2SButtonOutlined"
                        android:layout_marginBottom="@dimen/spacing_4" />

                    <!-- Error message (hidden by default) -->
                    <TextView
                        android:id="@+id/tvLoginError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:gravity="center"
                        android:textColor="@color/colorStatusDanger"
                        android:textSize="@dimen/text_body_small"
                        android:visibility="gone"
                        tools:text="Invalid credentials. Use demo login for testing."
                        tools:visibility="visible" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Version + Demo notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/app_version"
                android:textColor="@color/colorTextHint"
                android:textSize="@dimen/text_caption"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/mock_notice"
                android:textColor="@color/colorDemoLabel"
                android:textSize="@dimen/text_label"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_24"
                android:paddingEnd="@dimen/spacing_24" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>


