<?xml version="1.0" encoding="utf-8"?>
<!--
    Worker Dashboard - H2S Dosimeter
    =========================================
    Layout structure:
    1. Dark navy header with greeting, worker info, avatar, notification icon
    2. Scrollable body:
       a) Today's Exposure Status card (ring gauge + category chip)
       b) Quick Action buttons (Scan / History / Shift)
       c) Today's Shift card
       d) Recent Exposure Summary (recycler placeholder)
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".ui.dashboard.DashboardActivity">

    <!-- -
         TOP HEADER
         - -->
    <LinearLayout
        android:id="@+id/dashHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_primary"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingTop="@dimen/status_bar_padding"
        android:paddingBottom="@dimen/spacing_48">

        <!-- Row: greeting left, avatar + notification right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Greeting + name block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B0C4D8"
                    android:textSize="@dimen/text_body_small"
                    tools:text="Good Morning," />

                <TextView
                    android:id="@+id/tvWorkerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_title_large"
                    android:textStyle="bold"
                    android:layout_marginTop="@dimen/spacing_2"
                    tools:text="Ankita Demo" />

                <TextView
                    android:id="@+id/tvWorkerId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorAccent"
                    android:textSize="@dimen/text_caption"
                    android:layout_marginTop="@dimen/spacing_2"
                    tools:text="WRK-001" />

            </LinearLayout>

            <!-- Notification button -->
            <ImageView
                android:id="@+id/btnNotification"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:layout_marginEnd="@dimen/spacing_10"
                android:background="@drawable/bg_notification_btn"
                android:padding="@dimen/spacing_10"
                android:src="@drawable/ic_notification"
                android:contentDescription="@string/cd_notification_icon"
                android:clickable="true"
                android:focusable="true" />

            <!-- Avatar -->
            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="@dimen/avatar_size"
                android:layout_height="@dimen/avatar_size"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:contentDescription="@string/cd_profile_icon"
                android:clickable="true"
                android:focusable="true"
                tools:text="AD" />

        </LinearLayout>

    </LinearLayout>

    <!-- -
         SCROLLABLE CONTENT (overlaps header)
         - -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="120dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_40">

            <!-- ==============================================
                 CARD 1 - TODAY'S EXPOSURE STATUS
                 ============================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExposureStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardCornerRadius="@dimen/card_corner_radius_large"
                app:cardElevation="@dimen/card_elevation_raised"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <!-- Card title row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_16">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/lbl_today_exposure"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold" />

                        <!-- DEMO badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_demo"
                            style="@style/H2SDemoBadge" />

                    </LinearLayout>

                    <!-- Gauge + info side by side -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Ring Gauge (custom view) -->
                        <com.ankita.h2sdosimeter.ui.dashboard.ExposureGaugeView
                            android:id="@+id/exposureGauge"
                            android:layout_width="@dimen/gauge_size"
                            android:layout_height="@dimen/gauge_size"
                            android:contentDescription="@string/cd_exposure_gauge" />

                        <!-- Right info column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/spacing_16">

                            <!-- Exposure category chip -->
                            <TextView
                                android:id="@+id/tvExposureCategory"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_low"
                                android:paddingStart="@dimen/chip_padding_horizontal"
                                android:paddingEnd="@dimen/chip_padding_horizontal"
                                android:paddingTop="@dimen/chip_padding_vertical"
                                android:paddingBottom="@dimen/chip_padding_vertical"
                                android:textColor="@color/colorStatusSafe"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:layout_marginBottom="@dimen/spacing_8"
                                tools:text="LOW" />

                            <!-- Category description -->
                            <TextView
                                android:id="@+id/tvCategoryDesc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="@dimen/text_body_small"
                                android:layout_marginBottom="@dimen/spacing_12"
                                tools:text="Estimated exposure within monitored range." />

                            <!-- Divider -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/divider_height"
                                android:background="@color/colorDivider"
                                android:layout_marginBottom="@dimen/spacing_12" />

                            <!-- Shift label -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lbl_current_shift"
                                android:textColor="@color/colorTextHint"
                                android:textSize="@dimen/text_overline"
                                android:layout_marginBottom="@dimen/spacing_2" />
                            <TextView
                                android:id="@+id/tvCurrentShift"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:layout_marginBottom="@dimen/spacing_8"
                                tools:text="Morning Shift" />

                            <!-- Badge status label -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lbl_badge_status"
                                android:textColor="@color/colorTextHint"
                                android:textSize="@dimen/text_overline"
                                android:layout_marginBottom="@dimen/spacing_2" />
                            <TextView
                                android:id="@+id/tvBadgeStatusSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_valid"
                                android:paddingStart="@dimen/spacing_8"
                                android:paddingEnd="@dimen/spacing_8"
                                android:paddingTop="@dimen/spacing_2"
                                android:paddingBottom="@dimen/spacing_2"
                                android:textColor="@color/colorBadgeValid"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold"
                                tools:text="VALID (check)" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Estimated exposure value row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:background="@color/colorSurfaceVariant"
                        android:padding="@dimen/spacing_12">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lbl_estimated_exposure"
                                android:textColor="@color/colorTextHint"
                                android:textSize="@dimen/text_overline" />

                            <TextView
                                android:id="@+id/tvEstimatedExposure"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_title"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_2"
                                tools:text="0.8 ppm.hr [ESTIMATED - DEMO]" />

                        </LinearLayout>

                        <!-- DEMO badge on value -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_demo"
                            style="@style/H2SDemoBadge" />

                    </LinearLayout>

                    <!-- Disclaimer text -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="@string/demo_disclaimer"
                        android:textColor="@color/colorDemoLabel"
                        android:textSize="@dimen/text_label" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==============================================
                 QUICK ACTIONS
                 ============================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Actions"
                android:textColor="@color/colorTextPrimary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/spacing_12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/spacing_20">

                <!-- Scan -->
                <LinearLayout
                    android:id="@+id/btnQuickScan"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:background="@drawable/bg_quick_action"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:src="@drawable/ic_scan"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_6"
                        android:text="@string/btn_scan_wristband"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:gravity="center" />

                </LinearLayout>

                <!-- History -->
                <LinearLayout
                    android:id="@+id/btnQuickHistory"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_4"
                    android:layout_marginEnd="@dimen/spacing_4"
                    android:background="@drawable/bg_quick_action"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:src="@drawable/ic_history"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_6"
                        android:text="@string/btn_view_history"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Shift Details -->
                <LinearLayout
                    android:id="@+id/btnQuickShift"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:background="@drawable/bg_quick_action"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:src="@drawable/ic_shift"
                        android:contentDescription="@null" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_6"
                        android:text="@string/btn_shift_details"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_label"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:gravity="center" />

                </LinearLayout>
            </LinearLayout>

            <!-- ==============================================
                 CARD 2 - TODAY'S SHIFT
                 ============================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardShift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_16"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <!-- Card title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_16">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:src="@drawable/ic_shift"
                            android:contentDescription="@null"
                            app:tint="@color/colorPrimary"
                            android:layout_marginEnd="@dimen/spacing_8" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/lbl_today_shift"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Shift info grid (2 cols) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/spacing_12">

                        <!-- Shift name -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lbl_shift"
                                android:textColor="@color/colorTextHint"
                                android:textSize="@dimen/text_overline" />
                            <TextView
                                android:id="@+id/tvShiftName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_2"
                                tools:text="Morning Shift" />
                        </LinearLayout>

                        <!-- Start time -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lbl_start_time"
                                android:textColor="@color/colorTextHint"
                                android:textSize="@dimen/text_overline" />
                            <TextView
                                android:id="@+id/tvShiftStart"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_2"
                                tools:text="06:00" />
                        </LinearLayout>

                        <!-- End time -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lbl_end_time"
                                android:textColor="@color/colorTextHint"
                                android:textSize="@dimen/text_overline" />
                            <TextView
                                android:id="@+id/tvShiftEnd"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_2"
                                tools:text="14:00" />
                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:background="@color/colorDivider"
                        android:layout_marginBottom="@dimen/spacing_12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Badge ID -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lbl_badge_id"
                                android:textColor="@color/colorTextHint"
                                android:textSize="@dimen/text_overline" />
                            <TextView
                                android:id="@+id/tvBadgeId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_2"
                                tools:text="H2S-BDG-001" />
                        </LinearLayout>

                        <!-- Badge validity -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/lbl_validity"
                                android:textColor="@color/colorTextHint"
                                android:textSize="@dimen/text_overline" />
                            <TextView
                                android:id="@+id/tvBadgeValidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_valid"
                                android:paddingStart="@dimen/spacing_8"
                                android:paddingEnd="@dimen/spacing_8"
                                android:paddingTop="@dimen/spacing_2"
                                android:paddingBottom="@dimen/spacing_2"
                                android:textColor="@color/colorBadgeValid"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold"
                                android:layout_marginTop="@dimen/spacing_4"
                                tools:text="VALID (check)" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ==============================================
                 CARD 3 - RECENT EXPOSURE SUMMARY
                 ============================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRecentSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/card_corner_radius"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <!-- Header row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/spacing_16">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/lbl_recent_summary"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_demo"
                            style="@style/H2SDemoBadge" />

                    </LinearLayout>

                    <!-- Recent record rows populated in Java -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRecentRecords"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_exposure_record" />

                    <!-- See all link -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewAllHistory"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height_small"
                        android:text="View Full History"
                        style="@style/H2SButtonText"
                        android:layout_marginTop="@dimen/spacing_8" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>


